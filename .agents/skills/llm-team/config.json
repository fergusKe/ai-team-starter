{
  "schemaVersion": 2,
  "usage": { "mode": "off" },
  "writer": [
    { "harness": "agy", "model": "gemini-3.8-flash-high", "quotaBucket": "gemini" },
    { "harness": "gemini", "model": "gemini-3.8-flash", "quotaBucket": "gemini-api" }
  ],
  "profiles": {
    "claude": {
      "coordinator": { "harness": "claude", "model": "claude-code", "quotaBucket": "anthropic" },
      "reviewers": [
        { "harness": "claude", "model": "claude-opus-5-5", "quotaBucket": "anthropic" }
      ],
      "blockReviewers": [
        { "harness": "claude", "model": "claude-opus-5-5", "quotaBucket": "anthropic" },
        { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" }
      ],
      "postReviewers": [
        { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" }
      ],
      "adjudicator": { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" },
      "blockAdjudicator": "human"
    },
    "agy": {
      "coordinator": { "harness": "agy", "model": "gemini-3.1-pro-high", "quotaBucket": "gemini" },
      "reviewers": [
        { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" }
      ],
      "blockReviewers": [
        { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" }
      ],
      "postReviewers": [
        { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai" }
      ],
      "adjudicator": "human",
      "blockAdjudicator": "human"
    },
    "codex": {
      "coordinator": { "harness": "codex", "model": "gpt-5.6-sol", "quotaBucket": "openai", "effort": "medium" },
      "reviewers": [
        { "harness": "gemini", "model": "gemini-3.1-pro-preview", "quotaBucket": "gemini-api" }
      ],
      "blockReviewers": [
        { "harness": "gemini", "model": "gemini-3.1-pro-preview", "quotaBucket": "gemini-api" }
      ],
      "adjudicator": "human",
      "blockAdjudicator": "human"
    }
  },
  "allowCommandHeads": [
    "pnpm test",
    "pnpm run",
    "pnpm exec openspec validate",
    "bash .github/scripts/test-"
